{
    "manifest_version": 3,
    "name": "Morgann Music CP",
    "version": "1.3.1",
    "description": "Extension officielle Morgann Music CP — Portail & Notifications",
    "permissions": [
        "storage",
        "notifications",
        "alarms",
        "contextMenus"
    ],
    "host_permissions": [
        "https://api.worker.mm-cp.uk/*",
        "https://*.mm-cp.uk/*"
    ],
    "icons": {
        "16": "icon-16.png",
        "48": "icon-48.png",
        "128": "icon-128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon-16.png",
            "48": "icon-48.png",
            "128": "icon-128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    }
}