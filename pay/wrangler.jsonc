{
  "name": "pay",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "alias": {
    "stripe": "stripe"
  },
  "routes": [
    {
      "pattern": "pay.mm-cp.uk",
      "zone_name": "mm-cp.uk",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "morgann-music-cp"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ma-super-base",
      "database_id": "e21ef4d8-7e6a-436f-8cf4-eca72daf322f"
    }
  ]
}